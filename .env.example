# Nothing here is read unless the flags below say so.

# Whether the browser is allowed to open at all. Required to run roam_hive.py.
FLY_ALLOW_BROWSER=0

# How many workers the hive starts with. hive.py falls back to comb.toml's
# n_workers if this is unset.
COMB_WORKERS=8

# There is no live-signing path in this codebase to gate - no wallet, no
# provider, no key, ever, and no pons launch in this beta. This flag is not
# read anywhere (roam_hive.py has no reference to it at all). It exists only
# so it defaults to off, on the record, rather than being silently absent.
COMB_LIVE=0
